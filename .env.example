# 服务器
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# 数据库
DATABASE_URL=postgres://updates:updates@localhost:5432/updates?sslmode=disable
AUTO_MIGRATE=true

# 认证与接口访问
API_KEY=change-me
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=multi-platform-distribution
JWT_TTL=24h

# 初始管理员账号
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# 存储后端
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=data/uploads

# S3 存储配置，只有 STORAGE_DRIVER=s3 时才会使用
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=updates
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/updates
S3_USE_SSL=false
